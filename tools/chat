#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "openai>=1.50.0",
#   "anthropic>=0.40.0",
#   "prompt_toolkit>=3.0.43",
#   "rich>=13.7.0",
# ]
# ///
"""Interactive AI chat TUI for testing OpenAI / OpenAI Responses / Anthropic
compatible endpoints (e.g. NVIDIA NIM).

Usage:
    chat <endpoint> [--api openai|openai-response|anthropic] [--model NAME]
                    [--api-key KEY] [--system TEXT]

Examples:
    chat https://integrate.api.nvidia.com/v1
    chat http://localhost:8000/v1 --api openai --model meta/llama-3.1-70b-instruct
    chat https://api.anthropic.com --api anthropic --model claude-3-5-sonnet-latest

In-session commands:
    /help            show help
    /reset           clear conversation history
    /system <text>   set or replace system prompt
    /model <name>    switch model
    /save <path>     save conversation as JSON
    /quit, /exit     leave the chat
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable, Iterator

from prompt_toolkit import PromptSession
from prompt_toolkit.formatted_text import HTML
from prompt_toolkit.history import FileHistory
from prompt_toolkit.key_binding import KeyBindings
from rich.console import Console, Group
from rich.live import Live
from rich.markdown import Markdown
from rich.panel import Panel
from rich.prompt import Prompt
from rich.rule import Rule
from rich.text import Text

console = Console()

API_OPENAI = "openai"
API_OPENAI_RESPONSE = "openai-response"
API_ANTHROPIC = "anthropic"

API_CHOICES = (API_OPENAI, API_OPENAI_RESPONSE, API_ANTHROPIC)

HISTORY_FILE = Path.home() / ".cache" / "chat-tui" / "history.txt"


@dataclass
class ChatConfig:
    endpoint: str
    api: str
    model: str
    api_key: str
    system: str | None = None
    thinking: bool = False
    thinking_budget: int = 4000
    messages: list[dict] = field(default_factory=list)

    def reset(self) -> None:
        self.messages.clear()


# Stream chunk type: ("reasoning" | "content", text)
StreamChunk = tuple[str, str]
KIND_REASONING = "reasoning"
KIND_CONTENT = "content"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="chat",
        description="Interactive AI chat TUI (OpenAI / Responses / Anthropic)",
    )
    parser.add_argument("endpoint", help="Base URL of the API endpoint")
    parser.add_argument(
        "--api",
        choices=API_CHOICES,
        help="API protocol to use; if omitted you will be prompted",
    )
    parser.add_argument("--model", help="Model name to use")
    parser.add_argument(
        "--api-key",
        help="API key (falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY / NIM_API_KEY)",
    )
    parser.add_argument(
        "--system",
        help="System prompt (defaults to a small helpful assistant prompt)",
    )
    parser.add_argument(
        "--thinking",
        action="store_true",
        help="Enable extended thinking when supported (Anthropic; OpenAI reasoning models stream automatically)",
    )
    parser.add_argument(
        "--thinking-budget",
        type=int,
        default=4000,
        help="Token budget for Anthropic extended thinking (default: 4000)",
    )
    return parser.parse_args()


def select_api(initial: str | None) -> str:
    if initial:
        return initial
    console.print(Panel.fit("Select API protocol", border_style="cyan"))
    for idx, name in enumerate(API_CHOICES, start=1):
        console.print(f"  [bold cyan]{idx}[/bold cyan]. {name}")
    while True:
        choice = Prompt.ask("Choice", default="1")
        if choice in ("1", "2", "3"):
            return API_CHOICES[int(choice) - 1]
        if choice in API_CHOICES:
            return choice
        console.print("[red]Invalid choice[/red]")


def resolve_api_key(api: str, explicit: str | None) -> str:
    if explicit:
        return explicit

    env_keys = {
        API_OPENAI: ("OPENAI_API_KEY", "NIM_API_KEY"),
        API_OPENAI_RESPONSE: ("OPENAI_API_KEY", "NIM_API_KEY"),
        API_ANTHROPIC: ("ANTHROPIC_API_KEY",),
    }
    for var in env_keys[api]:
        value = os.environ.get(var)
        if value:
            return value

    # NIM and many self-hosted services accept any non-empty token; prompt user.
    return Prompt.ask("API key (input is hidden)", password=True, default="not-needed")


def list_models(api: str, endpoint: str, api_key: str) -> list[str]:
    """Fetch available models from the endpoint via SDK."""
    if api in (API_OPENAI, API_OPENAI_RESPONSE):
        from openai import OpenAI

        client = OpenAI(base_url=endpoint, api_key=api_key)
        return sorted({m.id for m in client.models.list().data})

    from anthropic import Anthropic

    client = Anthropic(base_url=endpoint, api_key=api_key)
    return sorted({m.id for m in client.models.list().data})


def resolve_model(api: str, endpoint: str, api_key: str, explicit: str | None) -> str:
    if explicit:
        return explicit

    console.print("[dim]fetching models from endpoint...[/dim]")
    try:
        models = list_models(api, endpoint, api_key)
    except Exception as exc:  # noqa: BLE001
        console.print(f"[yellow]could not list models ({exc}); please type one[/yellow]")
        return Prompt.ask("Model")

    if not models:
        console.print("[yellow]endpoint returned no models; please type one[/yellow]")
        return Prompt.ask("Model")

    console.print(Panel.fit("Select model", border_style="cyan"))
    for idx, name in enumerate(models, start=1):
        console.print(f"  [bold cyan]{idx:>3}[/bold cyan]. {name}")

    while True:
        choice = Prompt.ask("Choice (number or name)", default="1")
        if choice.isdigit():
            i = int(choice)
            if 1 <= i <= len(models):
                return models[i - 1]
        elif choice in models:
            return choice
        console.print("[red]invalid choice[/red]")


def build_prompt_session() -> PromptSession:
    HISTORY_FILE.parent.mkdir(parents=True, exist_ok=True)
    bindings = KeyBindings()

    @bindings.add("c-d")
    def _(event):
        event.app.exit(exception=EOFError)

    return PromptSession(
        history=FileHistory(str(HISTORY_FILE)),
        key_bindings=bindings,
        multiline=False,
        mouse_support=False,
    )


def print_banner(cfg: ChatConfig) -> None:
    body = Text()
    body.append(f"endpoint: {cfg.endpoint}\n", style="dim")
    body.append(f"api:      {cfg.api}\n", style="dim")
    body.append(f"model:    {cfg.model}\n", style="dim")
    body.append(f"thinking: {'on' if cfg.thinking else 'off'}\n", style="dim")
    body.append("Type '/help' for commands, '/quit' to exit.", style="bold cyan")
    console.print(Panel(body, title="chat", border_style="cyan"))


def print_help() -> None:
    console.print(
        Panel(
            "/help              show this help\n"
            "/reset             clear conversation history\n"
            "/system <text>     set or replace system prompt\n"
            "/model <name>      switch model\n"
            "/thinking on|off   toggle Anthropic extended thinking\n"
            "/save <path>       save conversation to JSON file\n"
            "/quit, /exit       leave the chat",
            title="commands",
            border_style="green",
        )
    )


def stream_openai_chat(cfg: ChatConfig, user_input: str) -> str:
    from openai import OpenAI

    client = OpenAI(base_url=cfg.endpoint, api_key=cfg.api_key)

    messages: list[dict] = []
    if cfg.system:
        messages.append({"role": "system", "content": cfg.system})
    messages.extend(cfg.messages)
    messages.append({"role": "user", "content": user_input})

    stream = client.chat.completions.create(
        model=cfg.model,
        messages=messages,
        stream=True,
    )
    return render_stream(_iter_openai_chat_chunks(stream))


def _iter_openai_chat_chunks(stream) -> Iterator[StreamChunk]:
    for chunk in stream:
        if not chunk.choices:
            continue
        delta = chunk.choices[0].delta
        # Reasoning content: convention used by NIM / DeepSeek-R1 / similar models.
        reasoning = getattr(delta, "reasoning_content", None) or getattr(delta, "reasoning", None)
        if reasoning:
            yield (KIND_REASONING, reasoning)
        text = getattr(delta, "content", None)
        if text:
            yield (KIND_CONTENT, text)


def stream_openai_response(cfg: ChatConfig, user_input: str) -> str:
    from openai import OpenAI

    client = OpenAI(base_url=cfg.endpoint, api_key=cfg.api_key)

    input_items: list[dict] = []
    if cfg.system:
        input_items.append({"role": "system", "content": cfg.system})
    input_items.extend(cfg.messages)
    input_items.append({"role": "user", "content": user_input})

    stream = client.responses.create(
        model=cfg.model,
        input=input_items,
        stream=True,
    )
    return render_stream(_iter_openai_response_chunks(stream))


def _iter_openai_response_chunks(stream) -> Iterator[StreamChunk]:
    reasoning_event_types = {
        "response.reasoning_summary_text.delta",
        "response.reasoning_text.delta",
    }
    for event in stream:
        event_type = getattr(event, "type", "")
        delta = getattr(event, "delta", "") or ""
        if not delta:
            continue
        if event_type in reasoning_event_types:
            yield (KIND_REASONING, delta)
        elif event_type == "response.output_text.delta":
            yield (KIND_CONTENT, delta)


def stream_anthropic(cfg: ChatConfig, user_input: str) -> str:
    from anthropic import Anthropic

    client = Anthropic(base_url=cfg.endpoint, api_key=cfg.api_key)

    messages = list(cfg.messages)
    messages.append({"role": "user", "content": user_input})

    kwargs: dict = {
        "model": cfg.model,
        "messages": messages,
        "max_tokens": 4096,
    }
    if cfg.system:
        kwargs["system"] = cfg.system
    if cfg.thinking:
        kwargs["thinking"] = {"type": "enabled", "budget_tokens": cfg.thinking_budget}
        # Anthropic requires max_tokens > thinking budget.
        kwargs["max_tokens"] = max(kwargs["max_tokens"], cfg.thinking_budget + 1024)

    with client.messages.stream(**kwargs) as stream:
        return render_stream(_iter_anthropic_chunks(stream))


def _iter_anthropic_chunks(stream) -> Iterator[StreamChunk]:
    for event in stream:
        event_type = getattr(event, "type", "")
        if event_type != "content_block_delta":
            continue
        delta = getattr(event, "delta", None)
        if delta is None:
            continue
        delta_type = getattr(delta, "type", "")
        if delta_type == "thinking_delta":
            text = getattr(delta, "thinking", "") or ""
            if text:
                yield (KIND_REASONING, text)
        elif delta_type == "text_delta":
            text = getattr(delta, "text", "") or ""
            if text:
                yield (KIND_CONTENT, text)


def render_stream(chunks: Iterable[StreamChunk]) -> str:
    """Render streamed chunks live: a thinking panel above and answer below.

    Returns the final answer text only, so reasoning is not appended to history.
    """
    console.print(Rule(style="grey50"))
    console.print(Text.assemble(("assistant", "bold magenta")))

    reasoning_buf: list[str] = []
    content_buf: list[str] = []

    def _renderable() -> Group:
        items: list = []
        if reasoning_buf:
            items.append(
                Panel(
                    Markdown("".join(reasoning_buf)),
                    title="thinking",
                    border_style="grey50",
                    style="dim",
                )
            )
        if content_buf:
            items.append(Markdown("".join(content_buf)))
        if not items:
            items.append(Text(" ", style="dim"))
        return Group(*items)

    interrupted = False
    with Live(
        _renderable(),
        console=console,
        refresh_per_second=24,
        vertical_overflow="visible",
        transient=False,
    ) as live:
        try:
            for kind, piece in chunks:
                if not piece:
                    continue
                if kind == KIND_REASONING:
                    reasoning_buf.append(piece)
                else:
                    content_buf.append(piece)
                live.update(_renderable())
        except KeyboardInterrupt:
            interrupted = True

    if interrupted:
        console.print("[yellow]stream interrupted[/yellow]")

    console.print(Rule(style="grey50"))
    return "".join(content_buf)


def handle_command(cfg: ChatConfig, line: str) -> bool:
    """Return True when the chat loop should continue, False to quit."""
    parts = line.strip().split(maxsplit=1)
    cmd = parts[0].lower()
    arg = parts[1] if len(parts) > 1 else ""

    if cmd in ("/quit", "/exit"):
        return False
    if cmd == "/help":
        print_help()
    elif cmd == "/reset":
        cfg.reset()
        console.print("[green]conversation cleared[/green]")
    elif cmd == "/system":
        cfg.system = arg or None
        console.print(f"[green]system prompt set:[/green] {cfg.system!r}")
    elif cmd == "/model":
        if arg:
            cfg.model = arg
            console.print(f"[green]model switched to[/green] {cfg.model}")
        else:
            console.print("[red]usage: /model <name>[/red]")
    elif cmd == "/thinking":
        if arg.lower() in ("on", "true", "1", "enable", "enabled"):
            cfg.thinking = True
            console.print("[green]thinking enabled[/green]")
        elif arg.lower() in ("off", "false", "0", "disable", "disabled"):
            cfg.thinking = False
            console.print("[green]thinking disabled[/green]")
        else:
            console.print("[red]usage: /thinking on|off[/red]")
    elif cmd == "/save":
        target = Path(arg).expanduser() if arg else Path("chat-history.json")
        target.write_text(
            json.dumps(
                {
                    "endpoint": cfg.endpoint,
                    "api": cfg.api,
                    "model": cfg.model,
                    "system": cfg.system,
                    "messages": cfg.messages,
                },
                ensure_ascii=False,
                indent=2,
            ),
            encoding="utf-8",
        )
        console.print(f"[green]saved:[/green] {target}")
    else:
        console.print(f"[red]unknown command:[/red] {cmd}")
    return True


def chat_loop(cfg: ChatConfig) -> None:
    session = build_prompt_session()
    print_banner(cfg)

    backends = {
        API_OPENAI: stream_openai_chat,
        API_OPENAI_RESPONSE: stream_openai_response,
        API_ANTHROPIC: stream_anthropic,
    }

    while True:
        try:
            line = session.prompt(HTML("<ansigreen><b>you</b></ansigreen> > "))
        except (EOFError, KeyboardInterrupt):
            console.print("\n[cyan]bye[/cyan]")
            return

        if not line.strip():
            continue
        if line.startswith("/"):
            if not handle_command(cfg, line):
                console.print("[cyan]bye[/cyan]")
                return
            continue

        try:
            reply = backends[cfg.api](cfg, line)
        except KeyboardInterrupt:
            console.print("\n[yellow]request cancelled[/yellow]")
            continue
        except Exception as exc:  # noqa: BLE001
            console.print(f"[red]request failed:[/red] {exc}")
            continue

        if reply.strip():
            cfg.messages.append({"role": "user", "content": line})
            cfg.messages.append({"role": "assistant", "content": reply})


def main() -> int:
    args = parse_args()
    api = select_api(args.api)
    api_key = resolve_api_key(api, args.api_key)
    model = resolve_model(api, args.endpoint, api_key, args.model)

    cfg = ChatConfig(
        endpoint=args.endpoint,
        api=api,
        model=model,
        api_key=api_key,
        system=args.system or "You are a concise, helpful assistant for daily testing.",
        thinking=args.thinking,
        thinking_budget=args.thinking_budget,
    )

    chat_loop(cfg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
